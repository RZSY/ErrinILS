{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-debug",
            "type": "shell",
            "windows": {
                "command": "cmd.exe",
                "args": ["/c", "${workspaceFolder}\\ErrinILS-source\\build.bat", "debug"]
            },
            "linux": {
                "command": "bash",
                "args": ["-c", "${workspaceFolder}/ErrinILS-source/build.sh"]
            },
            "osx": {
                "command": "bash",
                "args": ["-c", "${workspaceFolder}/ErrinILS-source/build.sh"]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "build-release",
            "type": "shell",
            "windows": {
                "command": "cmd.exe",
                "args": ["/c", "${workspaceFolder}\\ErrinILS-source\\build.bat", "release"]
            },
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "build-selftest",
            "type": "shell",
            "windows": {
                "command": "cmd.exe",
                "args": ["/c", "${workspaceFolder}\\ErrinILS-source\\build.bat", "selftest"]
            },
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        }
    ]
}
